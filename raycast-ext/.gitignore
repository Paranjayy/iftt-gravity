dist/
.DS_Store

# Build output (Raycast writes compiled .js to ~/.config/raycast-x/extensions/gravity-hub,
# but if you ever run `bun run build` with a different config or in CI, it may also write here)
*.js.map
.eslintcache

# Pre-fix backups of the original mislabeled JPEG icon (kept locally, not in git)
/_archive_icon.png.bak
/assets/_archive/

# Note: root-level *.png icon copies (control.png, hub.png, notes.png, etc.)
# are committed and referenced by Raycast script commands via @raycast.icon
# They can be regenerated by: python3 scripts/make-command-icons.py
